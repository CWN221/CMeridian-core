<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="loginContainer" prefHeight="600.0" prefWidth="800.0" styleClass="login-container" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.desktop.controller.LoginController">

    <!-- Window controls -->
    <HBox alignment="TOP_RIGHT" pickOnBounds="false" spacing="4" style="-fx-padding: 12 16 0 0;" StackPane.alignment="TOP_RIGHT" />

    <!-- Centered login card -->
    <VBox alignment="CENTER_LEFT" maxWidth="400" spacing="28" styleClass="login-card">

        <!-- Brand (centered) -->
        <VBox alignment="CENTER" spacing="8" styleClass="brand">
            <Text styleClass="title" text="Banking System" />
            <Text styleClass="subtitle" text="Sign in to your account" />
        </VBox>

        <!-- Form -->
        <VBox spacing="20" styleClass="login-form">
            <VBox spacing="10">
                <Label styleClass="field-label" text="Username" />
                <TextField fx:id="usernameField" prefHeight="44" promptText="Enter your username" />
            </VBox>

            <VBox spacing="10">
                <Label styleClass="field-label" text="Password" />
                <PasswordField fx:id="passwordField" prefHeight="44" promptText="Enter your password" />
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" visible="false" wrapText="true" />

            <HBox alignment="CENTER_LEFT" spacing="8">
                <CheckBox fx:id="rememberMeCheck" styleClass="checkbox" text="Remember me" />
                <Region HBox.hgrow="ALWAYS" />
                <Hyperlink onAction="#handleForgotPassword" styleClass="forgot-link" text="Forgot password?" />
            </HBox>

            <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" prefHeight="46" styleClass="btn-primary" text="Sign in" />

            <HBox alignment="CENTER" spacing="8">
                <ProgressIndicator fx:id="loadingIndicator" managed="false" style="-fx-pref-width: 20; -fx-pref-height: 20;" visible="false" />
            </HBox>
        </VBox>

    </VBox>
</StackPane>
