<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.desktop.controller.AccountsController">

    <top>
        <HBox styleClass="topbar">
            <VBox>
                <Label styleClass="page-title" text="Accounts" />
                <Label styleClass="page-subtitle" text="Customer deposit accounts across all branches" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" promptText="Search account or customer" styleClass="search-field" />
            <Button onAction="#onRefresh" styleClass="btn-secondary" text="Refresh" />
            <Button onAction="#onOpenAccount" styleClass="btn-primary" text="Open Account" />
        </HBox>
    </top>

    <center>
        <VBox styleClass="content-area">
            <HBox spacing="16">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-label" text="Total Accounts" />
                    <Label fx:id="statsTotal" styleClass="stat-value" text="0" />
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-label" text="Total Deposits" />
                    <Label fx:id="statsBalance" styleClass="stat-value" text="0" />
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-label" text="Frozen" />
                    <Label fx:id="statsFrozen" styleClass="stat-value" text="0" />
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-label" text="Active" />
                    <Label fx:id="statsActive" styleClass="stat-value" text="0" />
                </VBox>
            </HBox>

            <VBox styleClass="panel" VBox.vgrow="ALWAYS">
                <VBox styleClass="panel-header">
                    <Label styleClass="section-title" text="Account Register" />
                </VBox>
                <TableView fx:id="accountTable" prefHeight="420" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAccountNumber" prefWidth="180" text="Account Number" />
                        <TableColumn fx:id="colCustomer" prefWidth="200" text="Customer" />
                        <TableColumn fx:id="colType" prefWidth="140" text="Type" />
                        <TableColumn fx:id="colCurrency" prefWidth="90" text="Currency" />
                        <TableColumn fx:id="colBalance" prefWidth="132.00006103515625" text="Balance" />
                        <TableColumn fx:id="colOpened" prefWidth="123.2000732421875" text="Opened" />
                        <TableColumn fx:id="colStatus" prefWidth="98.4000244140625" text="Status" />
                        <TableColumn fx:id="colActions" prefWidth="257.5999755859375" text="Actions" />
                    </columns>
                    <placeholder>
                        <Label text="No accounts yet. Click Open Account to create the first one." />
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
